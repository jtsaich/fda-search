# HuggingFace API Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=fda-documents

# Backend Configuration
BACKEND_URL=http://localhost:8000
UPLOAD_DIR=./backend/uploads

# STARLIMS SQL Server Configuration
# Local default: 127.0.0.1
# Railway: use the SQL Server service private/internal host when available.
STARLIMS_SQL_HOST=your_sql_server_host_here
STARLIMS_SQL_PORT=1433
STARLIMS_SQL_DATABASE=STARLIMS_DATA
# Use a read-only application login, not sa, outside local throwaway testing.
STARLIMS_SQL_USER=your_readonly_sql_user_here
STARLIMS_SQL_PASSWORD=your_sql_password_here
STARLIMS_SQL_TIMEOUT_SECONDS=20

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (for chat persistence)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=our_supabase_publishable_key_here
